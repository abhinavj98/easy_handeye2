<?xml version="1.0"?>
<?xml-model
        href="http://download.ros.org/schema/package_format3.xsd"
        schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>easy_handeye2_franka_auto</name>
    <version>0.1.0</version>
    <description>
        Automated eye-on-base hand-eye sampling via pylibfranka
    </description>
    <maintainer email="local@example.com">Local</maintainer>
    <license>BSD</license>

    <exec_depend>rclpy</exec_depend>
    <exec_depend>tf2_ros</exec_depend>
    <exec_depend>geometry_msgs</exec_depend>
    <exec_depend>easy_handeye2</exec_depend>
    <exec_depend>easy_handeye2_msgs</exec_depend>
    <exec_depend>python3-yaml</exec_depend>
    <!-- evaluate_calibration uses cv2.calibrateHandEye (any OpenCV >= 4.1) -->

    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>
