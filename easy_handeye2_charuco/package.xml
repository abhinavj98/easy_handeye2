<?xml version="1.0"?>
<?xml-model
        href="http://download.ros.org/schema/package_format3.xsd"
        schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>easy_handeye2_charuco</name>
    <version>0.1.0</version>
    <description>
        ChArUco board TF publisher, visual test tools and eye-on-base bring-up
        (RealSense + ChArUco + handeye_server) for easy_handeye2
    </description>
    <maintainer email="local@example.com">Local</maintainer>
    <license>BSD</license>

    <!-- OpenCV >= 4.7 is required (cv2.aruco.CharucoDetector); see README -->
    <exec_depend>rclpy</exec_depend>
    <exec_depend>sensor_msgs</exec_depend>
    <exec_depend>geometry_msgs</exec_depend>
    <exec_depend>cv_bridge</exec_depend>
    <exec_depend>tf2_ros</exec_depend>
    <exec_depend>python3-numpy</exec_depend>
    <exec_depend>python3-yaml</exec_depend>
    <exec_depend>python3-pil</exec_depend>

    <exec_depend>launch</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>realsense2_camera</exec_depend>
    <exec_depend>easy_handeye2</exec_depend>
    <exec_depend>rviz2</exec_depend>
    <exec_depend>rqt_image_view</exec_depend>

    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>
